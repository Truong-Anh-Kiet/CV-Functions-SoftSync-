# ============================================================
#  AIP491 Backend — file .env mẫu
#  Cách dùng: copy file này thành ".env" rồi điền giá trị thật.
#  KHÔNG commit file .env (đã nằm trong .gitignore).
#  Xin bộ giá trị thật từ trưởng nhóm, không đăng công khai.
# ============================================================

# ---------------- Ứng dụng ----------------
APP_NAME_BE="AIP491 Backend"
APP_DEBUG_=false                     # true = bật log/chi tiết lỗi khi dev
API_V1_PREFIX="/api/v1"

# URL công khai của backend, dùng để tạo link preview file (/static/...).
# - Chạy local: giữ http://localhost:8000
# - Share qua Dev Tunnels: đổi thành URL tunnel cổng 8000
#   ví dụ https://aip491-xxxx-8000.asse.devtunnels.ms
BACKEND_PUBLIC_URL="http://localhost:8000"

# ---------------- Cơ sở dữ liệu (PostgreSQL) ----------------
# Định dạng: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# ---------------- Xác thực / JWT ----------------
JWT_SECRET_KEY="change-this-secret-key-before-production"  # chuỗi ngẫu nhiên dài, đổi trước khi lên production
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
# Chỉ bật true khi test local (trả OTP trong response). Production phải để false.
AUTH_RETURN_OTP_IN_RESPONSE=false

# ---------------- Email (Gmail SMTP) ----------------
# Dùng "App Password" của Google (16 ký tự), KHÔNG dùng mật khẩu Gmail thường.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-gmail@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"
SMTP_FROM_EMAIL="your-gmail@gmail.com"
SMTP_FROM_NAME="AIP491"
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=20

# ---------------- Đăng nhập Google (tùy chọn) ----------------
# Để trống nếu chỉ dùng email/mật khẩu. Google login KHÔNG chạy trên domain
# tunnel trừ khi thêm URL đó vào Authorized JavaScript origins ở Google Cloud Console.
GOOGLE_CLIENT_ID=""

# ---------------- Cloudinary (lưu file CV) ----------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------- Kết nối AI Service ----------------
# BE gọi AI service nội bộ, không cần mở ra ngoài khi share.
AI_SERVICE_URL="http://127.0.0.1:8001"
AI_SERVICE_TIMEOUT_SECONDS=600      # matching/ML có thể chạy lâu, để timeout cao

# ============================================================
#  Nguồn tìm CV bên ngoài (CareerViet / VietnamWorks / Academic)
#  Để MOCK_ENABLED=true nếu chưa có tài khoản HR -> trả dữ liệu giả để demo UI.
# ============================================================

# ---------------- CareerViet ----------------
CAREERVIET_BASE_URL="https://careerviet.vn"
CAREERVIET_API_BASE_URL="https://internal-api.careerviet.vn"
CAREERVIET_SEARCH_PATH="/vi/tim-ung-vien/nganh-nghe/cntt-phan-mem"
CAREERVIET_DEFAULT_INDUSTRY_IDS="1"
CAREERVIET_KEYWORD_MATCH_TYPE=1
CAREERVIET_HR_EMAIL=""               # tài khoản HR (employer) CareerViet
CAREERVIET_HR_PASSWORD=""
# Cookie header đầy đủ từ trình duyệt HR đã đăng nhập (phải chứa employer-tokens).
# Cookie/token sẽ hết hạn theo thời gian -> cần cập nhật lại khi bị lỗi "session expired".
CAREERVIET_SESSION_COOKIE=""
CAREERVIET_REQUEST_TIMEOUT_SECONDS=30
CAREERVIET_MOCK_ENABLED=true         # true = dữ liệu giả; false = gọi CareerViet thật (cần cookie)
CAREERVIET_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36"

# ---------------- VietnamWorks ----------------
VIETNAMWORKS_BASE_URL="https://employer.vietnamworks.com"
VIETNAMWORKS_GRAPHQL_URL="https://ms.vietnamworks.com/resume-search-api/graphql"
VIETNAMWORKS_SEARCH_URL="https://employer.vietnamworks.com/v3/candidate/search"
VIETNAMWORKS_HR_EMAIL=""
VIETNAMWORKS_HR_PASSWORD=""
VIETNAMWORKS_ONB_JWT=""              # JWT lấy từ trình duyệt HR đã đăng nhập
VIETNAMWORKS_SESSION_COOKIE=""
VIETNAMWORKS_REQUEST_TIMEOUT_SECONDS=30
VIETNAMWORKS_MOCK_ENABLED=true       # true = dữ liệu giả; false = gọi thật
VIETNAMWORKS_ACCEPT_LANGUAGE=1
VIETNAMWORKS_LOCALE="vn"
VIETNAMWORKS_SORT_BY="lastdateupdated"
VIETNAMWORKS_SEARCH_BY=3
VIETNAMWORKS_DEFAULT_FILTERS=""
VIETNAMWORKS_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36"

# ---------------- Tìm kiếm học thuật (OpenAlex / Semantic Scholar) ----------------
ACADEMIC_SEARCH_PROVIDER="openalex"  # openalex | semantic_scholar | hybrid
OPENALEX_BASE_URL="https://api.openalex.org"
OPENALEX_MAILTO=""                   # email của bạn (OpenAlex khuyến nghị để vào "polite pool")
OPENALEX_DEFAULT_QUERY="computer science"
OPENALEX_REQUEST_TIMEOUT_SECONDS=30
OPENALEX_MOCK_ENABLED=false
OPENALEX_MAX_AUTHORS_PER_WORK=3
OPENALEX_USER_AGENT="AIP491 academic search (mailto:your-email@example.com)"
SEMANTIC_SCHOLAR_BASE_URL="https://api.semanticscholar.org/graph/v1"
SEMANTIC_SCHOLAR_API_KEY=""          # tùy chọn, có key thì ít bị giới hạn tần suất
SEMANTIC_SCHOLAR_REQUEST_TIMEOUT_SECONDS=30
SEMANTIC_SCHOLAR_MAX_AUTHORS_PER_PAPER=3
SEMANTIC_SCHOLAR_USER_AGENT="AIP491 academic search"
