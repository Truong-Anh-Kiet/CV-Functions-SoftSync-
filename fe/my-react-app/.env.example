# URL của backend (BE). Chạy local: giữ nguyên localhost:8000.
# Khi share qua Dev Tunnels: đổi thành URL tunnel của cổng 8000,
# ví dụ https://aip491-xxxx-8000.asse.devtunnels.ms
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth client id (để trống nếu chỉ đăng nhập bằng email/mật khẩu).
# Lưu ý: Google login KHÔNG hoạt động trên domain tunnel trừ khi thêm URL đó
# vào Authorized JavaScript origins trong Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
