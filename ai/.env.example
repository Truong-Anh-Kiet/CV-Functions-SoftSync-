APP_NAME_AI="AIP491 AI Service"
APP_DEBUG=false
API_V1_PREFIX="/api/v1"

# --- OpenAI (CV/JD extraction) ---
OPENAI_API_KEY="sk-..."
# gpt-4o-mini is ~2-3x faster & far cheaper than gpt-4o for structured extraction
# (the real end-to-end bottleneck). Use "gpt-4o" for max extraction quality.
OPENAI_MODEL="gpt-4o-mini"

# --- Models ---
MODELS_DIR="./checkpoints"          # resolved against the ai/ repo root (CWD-independent)
DEFAULT_MODEL_ID="cross_weighted"   # best cross-encoder (mBERT)
TMP_DIR="./tmp"

# --- Inference runtime ---
AI_DEVICE="auto"                    # auto | cpu | cuda  (auto = cuda if available)
# CPU thread count for torch. 0 = auto (capped ~8; torch's default over-subscribes
# many-core CPUs, ~2.8x slower for this model). Override with your physical core count.
TORCH_NUM_THREADS=0
SKIP_EMPTY_VIEW_PAIRS=true          # skip backbone on empty view pairs (output-identical)
# Length-bucketed inference: chunk size for sorting view pairs by length so one long
# view doesn't pad every pair. ~3.2x on CPU, output-identical. Best 5-6. 0 = off.
INFERENCE_PAIR_CHUNK=6
WARMUP_ON_STARTUP=true              # preload backbone + heads at startup (no cold start)
INFERENCE_BACKEND="torch"           # torch | onnx (onnx = optional, CPU-only, FP32)

# --- Extraction cache ---
# Cache OpenAI extraction by content hash → identical CV/JD re-runs are instant.
EXTRACTION_CACHE=true
